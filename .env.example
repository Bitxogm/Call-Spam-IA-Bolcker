# ========================================
# CONFIGURACIÓN DE API KEYS
# ========================================
#
# Copia este archivo a ".env" y rellena con tus claves reales
# IMPORTANTE: NO subas el archivo .env al repositorio (está en .gitignore)

# ========================================
# GEMINI AI (OBLIGATORIO)
# ========================================
# Para obtener tu API key gratuita:
# 1. Ve a: https://makersuite.google.com/app/apikey
# 2. Crea un nuevo proyecto (si no tienes uno)
# 3. Genera una API key
# 4. Copia la key aquí

EXPO_PUBLIC_GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# Modelo recomendado (gemini-1.5-flash es el más rápido y económico)
EXPO_PUBLIC_GEMINI_MODEL=gemini-1.5-flash

# ========================================
# ELEVENLABS TTS (OPCIONAL)
# ========================================
# Para voz realista con IA (opcional, tiene fallback a TTS nativo)
# Para obtener tu API key:
# 1. Ve a: https://elevenlabs.io/
# 2. Crea cuenta gratuita (10,000 caracteres/mes gratis)
# 3. Ve a Profile > API Keys
# 4. Genera una API key
# 5. Copia la key aquí

EXPO_PUBLIC_ELEVENLABS_API_KEY=tu_api_key_de_elevenlabs_aqui

# ========================================
# NOTAS IMPORTANTES
# ========================================
#
# 1. Gemini AI es OBLIGATORIO para que funcione el agente IA
#    - Sin esta key, la app detectará llamadas pero no podrá conversar
#    - La API de Gemini tiene cuota gratuita generosa
#    - Modelo recomendado: gemini-1.5-flash (rápido y barato)
#
# 2. ElevenLabs es OPCIONAL
#    - Si no tienes key, usará TTS nativo del teléfono (menos realista)
#    - Recomendado para producción (voces muy realistas)
#    - Cuota gratuita: 10,000 caracteres/mes
#
# 3. NO compartas tus API keys con nadie
#
# 4. NO subas el archivo .env al repositorio
#
# 5. Reinicia la app después de cambiar estas variables

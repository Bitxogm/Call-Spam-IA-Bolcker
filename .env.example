# ========================================
# CONFIGURACIÓN DE LA APP
# ========================================
#
# Copia este archivo a ".env" y rellena con tus valores reales
# IMPORTANTE: NO subas el archivo .env al repositorio (está en .gitignore)

# ========================================
# VPS (Modos 2 y 3)
# ========================================
# URL pública de control_api.py (Cloudflare → Nginx Proxy Manager → Flask).
# La app la usa para sincronizar el modo activo y descargar el historial de
# llamadas atendidas por Manolo.
#
# Tiene que ser https: en release Android bloquea el tráfico en claro
# (usesCleartextTraffic solo está en el manifest de debug).

EXPO_PUBLIC_VPS_URL=https://tu-subdominio.tu-dominio.com

# Debe coincidir con CONTROL_API_TOKEN del .env del VPS.
# Generarlo con: python3 -c "import secrets; print(secrets.token_urlsafe(32))"

EXPO_PUBLIC_CONTROL_API_TOKEN=

# ========================================
# NOTAS
# ========================================
#
# 1. La IA (Groq) y el TTS (Edge TTS) corren en el SERVIDOR, no en la app.
#    Sus claves viven en el .env del VPS, no aquí.
#
# 2. El prefijo EXPO_PUBLIC_* embebe estos valores en el APK compilado.
#    ⚠️ Eso incluye el token: cualquiera con el APK puede extraerlo. Aceptable
#    mientras la app no se distribuya. La solución definitiva (pedir el token
#    una vez y guardarlo en EncryptedSharedPreferences) está en el roadmap.
#
# 3. Reinicia la app después de cambiar estas variables.

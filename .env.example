# ========================================
# CONFIGURACIÓN DE LA APP
# ========================================
#
# Copia este archivo a ".env" y rellena con tus valores reales
# IMPORTANTE: NO subas el archivo .env al repositorio (está en .gitignore)

# ========================================
# VPS (Modos 2 y 3)
# ========================================
# IP y puerto donde corre control_api.py (Flask) en el VPS.
# La app los usa para sincronizar el modo activo, el mensaje fijo
# y descargar el historial de llamadas atendidas por Manolo.

EXPO_PUBLIC_VPS_IP=157.180.35.161
EXPO_PUBLIC_VPS_PORT=5000

# ========================================
# NOTAS
# ========================================
#
# 1. La IA (Groq) y el TTS (Edge TTS) corren en el SERVIDOR, no en la app.
#    Sus claves viven en /root/ai_bridge/.env del VPS, no aquí.
#
# 2. El prefijo EXPO_PUBLIC_* embebe estos valores en el APK compilado.
#
# 3. Reinicia la app después de cambiar estas variables.
